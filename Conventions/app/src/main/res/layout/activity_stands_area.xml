<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".events.activities.StandsAreaFragment">

    <FrameLayout
        android:id="@+id/stands_area_zoom_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible">
        <pl.polidea.view.ZoomView
            android:id="@+id/stands_area_zoom"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <amai.org.conventions.customviews.FrameLayoutWithMaxHeight
                android:id="@+id/stands_area_map_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:maxHeight="300dp">
                <amai.org.conventions.customviews.PaintableImageView
                    android:id="@+id/stands_area_map"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </amai.org.conventions.customviews.FrameLayoutWithMaxHeight>
        </pl.polidea.view.ZoomView>
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom|end"
            android:background="@color/transparent_black"
            android:padding="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/fullscreen_24px"
            />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/standsList"
        android:layout_width="match_parent"
        android:horizontalSpacing="5dp"
        android:verticalSpacing="3dp"
        android:gravity="center_vertical"
        android:layout_height="0dp"
        android:layout_weight="1">

    </androidx.recyclerview.widget.RecyclerView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/stands_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/close"
            style="@style/BorderlessButton"/>
    </FrameLayout>

</LinearLayout>
