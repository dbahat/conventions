<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/safe_space_scroll"
    android:clipToPadding="false"
    tools:context="amai.org.conventions.SafeSpaceActivity">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_marginStart="?contentStartMargin"
            android:layout_marginEnd="?contentEndMargin"
            android:orientation="vertical">
        <amai.org.conventions.customviews.AspectRatioImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:src="?safeSpaceLogo"
            android:layout_gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?infoActivitiesTextBackground"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:orientation="vertical">

            <TextView
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.AppCompat.Body2"/>

            <Button
                android:id="@+id/safe_space_button"
                style="@style/HomeButton.Single"
                android:text="@string/safe_space_button_whatsapp"
                android:background="?highlightedButtonBackground"
                android:textColor="?buttonTextColor"
                android:onClick="onContactSafeSpaceClicked"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/scroll_view_bottom_padding"/>
    </LinearLayout>
</ScrollView>