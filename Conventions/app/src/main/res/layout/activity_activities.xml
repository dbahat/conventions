<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/activities_scroll"
    android:clipToPadding="false"
    tools:context="amai.org.conventions.ActivitiesActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/activities_content_container"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:layout_marginStart="?contentStartMargin"
        android:layout_marginEnd="?contentEndMargin"
        android:background="?infoActivitiesTextBackground"
        android:orientation="vertical">
<!--        <TextView-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="@string/activities_main_title"-->
<!--            android:layout_marginBottom="20dp"-->
<!--            android:textSize="18sp"-->
<!--            android:textColor="?android:textColorPrimary"-->
<!--            />-->


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:textColorPrimary"
            android:textSize="14sp"
            android:text="@string/activities_glhf"
            android:layout_marginBottom="15dp"/>
        <amai.org.conventions.customviews.AspectRatioImageView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/icon2025_activities_glhf"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:text="@string/activities_icode"
            android:layout_marginBottom="15dp"/>
        <amai.org.conventions.customviews.AspectRatioImageView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/icon2025_activities_icode"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:textColorPrimary"
            android:textSize="14sp"
            android:text="@string/activities_spaceship"
            android:layout_marginBottom="15dp"/>
        <amai.org.conventions.customviews.AspectRatioImageView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/icon2025_discounts_spaceship"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:textColorPrimary"
            android:textSize="14sp"
            android:text="@string/activities_legion"
            android:layout_marginBottom="15dp"/>
        <amai.org.conventions.customviews.AspectRatioImageView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/icon2025_discounts_legion"
            android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:textColorPrimary"
        android:textSize="14sp"
        android:text="@string/activities_indie_games"
        android:layout_marginBottom="30dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/scroll_view_bottom_padding"/>
    </LinearLayout>
</ScrollView>