        <item name="lightStatusBarIcons">false</item>
    </style>

    <style name="AppDialogTheme.Harucon2026" parent="Theme.AppCompat.Light.Dialog">
        <!-- This is the default starting API23. In any case the title is always left-justified so it's best to not use it. -->
        <item name="android:windowNoTitle">true</item>
        <!-- Used for configure notifications popup title and separator -->
        <item name="colorAccent">@color/harucon2026_red1</item>
        <item name="borderlessButtonColor">@color/harucon2026_red1</item>
        <item name="android:textColorPrimary">@color/harucon2026_eggplant1</item>
        <item name="android:layoutDirection">rtl</item>
        <!-- For stands popup in map - unselected stand text color -->
        <item name="mapSearchText">@color/harucon2026_eggplant1</item>
    </style>

    <style name="AppAlertDialogTheme.Harucon2026" parent="Theme.AppCompat.Light.Dialog.Alert">
        <!-- Used for configure notifications popup title and separator -->
        <item name="colorAccent">@color/harucon2026_red1</item>
        <item name="borderlessButtonColor">@color/harucon2026_red1</item>
        <item name="android:textColorPrimary">@color/harucon2026_eggplant1</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="AppBaseTheme.Harucon2026.Splash">
