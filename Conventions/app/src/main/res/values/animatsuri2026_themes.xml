    <style name="AppDialogTheme.Animatsuri2026" parent="Theme.AppCompat.Light.Dialog">
        <!-- This is the default starting API23. In any case the title is always left-justified so it's best to not use it. -->
        <item name="android:windowNoTitle">true</item>
        <!-- Used for configure notifications popup title and separator -->
        <item name="colorAccent">@color/animatsuri2026_pink700</item>
        <item name="borderlessButtonColor">@color/animatsuri2026_pink700</item>
        <item name="android:textColorPrimary">@color/animatsuri2026_darkest_blue</item>
        <item name="android:layoutDirection">rtl</item>
