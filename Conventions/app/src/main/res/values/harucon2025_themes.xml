        <!-- Safe Space Screen -->
        <item name="safeSpaceLogo">@drawable/harucon2025_safe_space</item>
    </style>

    <style name="AppBaseTheme.Harucon2025.Event">
        <item name="android:textColorLink">@color/harucon2025_pink6</item>
    </style>

    <style name="AppDialogTheme.Harucon2025" parent="Theme.AppCompat.Light.Dialog">
        <!-- This is the default starting API23. In any case the title is always left-justified so it's best to not use it. -->
        <item name="android:windowNoTitle">true</item>
        <!-- Used for configure notifications popup title and separator -->
        <item name="colorAccent">@color/harucon2025_pink6</item>
        <item name="borderlessButtonColor">@color/harucon2025_pink6</item>
        <item name="android:textColorPrimary">@color/harucon2025_purple4</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="AppAlertDialogTheme.Harucon2025" parent="Theme.AppCompat.Light.Dialog.Alert">
        <!-- Used for configure notifications popup title and separator -->
        <item name="colorAccent">@color/harucon2025_pink6</item>
        <item name="borderlessButtonColor">@color/harucon2025_pink6</item>
        <item name="android:textColorPrimary">@color/harucon2025_purple4</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="AppBaseTheme.Harucon2025.Splash">
        <item name="android:windowBackground">@drawable/harucon2025_home_background</item>
    </style>
</resources>

