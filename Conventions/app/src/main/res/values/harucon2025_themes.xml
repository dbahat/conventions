<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme.Harucon2025" parent="AppBaseTheme.HaruconGen">
        <!-- Sub-themes -->
        <item name="android:dialogTheme">@style/AppDialogTheme.Harucon2025</item>
        <item name="alertDialogTheme">@style/AppAlertDialogTheme.Harucon2025</item>
        <!-- General -->
        <item name="android:colorPrimaryDark">@color/black</item> <!-- Toolbar color -->
        <!-- Used in: default selected checkbox/switch color, settings titles,
             cursor color in all edit texts. Also used as the default action button color and map search checkbox color. -->
        <item name="colorAccent">@color/harucon2025_purple4</item>
        <!-- This color should be readable over the activities background.
             Used as the text color in: accessibility, arrival methods.
             Also used as default for many texts and as the default "large text" color (e.g. in settings). -->
        <item name="android:textColorPrimary">@color/harucon2025_purple5</item>
        <!-- Used in: default unselected checkbox color and default "medium/small" texts (e.g. in settings). -->
        <item name="android:textColorSecondary">@color/harucon2025_purple4</item>
        <item name="android:textColorHint">@color/harucon2025_purple5</item>
        <item name="android:textColorLink">@color/harucon2025_pink6</item>
        <item name="actionButtonColor">@color/harucon2025_peach4</item>
        <item name="actionButtonIcon">@drawable/harucon_gen_search_icon</item>
        <item name="hintTextColor">@color/harucon2025_purple5</item>
        <item name="swipeToRefreshColor">@color/white</item>
        <item name="swipeToRefreshBackgroundColor">@color/harucon2025_peach4</item>
        <item name="snackbarActionColor">@color/harucon2025_pink6</item>
        <item name="borderlessButtonColor">@color/harucon2025_pink6</item>
        <item name="activitiesBackground">@drawable/harucon2025_app_background</item>
        <item name="infoActivitiesBackground">@color/harucon2025_yellow1</item>
        <item name="eventListDivider">@drawable/harucon_gen_event_list_divider</item>
        <item name="separatorColor">@null</item>
        <!-- These are used for buttons. They should be usable when the background is:
             Event screen vote survey
             Feedback screen
             Map bottom info panel
             Arrival methods screen
         -->
        <item name="buttonColor">@color/harucon2025_pink6</item>
        <item name="buttonColorPressed">@color/harucon2025_pink4</item>
        <item name="buttonColorDisabled">@color/harucon2025_gray5</item>
        <item name="buttonTextColor">@drawable/harucon2025_highlighted_button_text_color</item>
        <item name="highlightedButtonRadius">8dp</item>

        <!-- Notifications -->
        <item name="notificationSmallIcon">@drawable/harucon_notification_small</item>
        <!-- Toolbar -->
        <item name="toolbarBackground">@color/harucon2025_purple5</item>
        <item name="toolbarIconAccentColor">@color/harucon2025_peach4</item>
        <item name="toolbarTitleColor">@color/white</item>
        <!-- Navigation Drawer -->
        <item name="navigationPopupBackground">@color/harucon2025_yellow1</item>
        <item name="navigationPopupSpaceVisibility">gone</item>
        <item name="navigationPopupTitle">@null</item>
        <item name="navigationPopupBottomImage">@null</item>
        <item name="navigationPopupTopSelectedColor">@color/harucon2025_red3</item>
        <item name="navigationPopupTopNotSelectedColor">@color/harucon2025_red3</item>
        <item name="navigationPopupNotSelectedColor">@color/harucon2025_red3</item>
        <item name="navigationPopupSelectedColor">@color/harucon2025_red3</item>
        <item name="navigationPopupSelectedBackground">@color/harucon2025_peach1</item>
        <item name="navigationPopupSeparatorColor">@color/transparent</item>
        <item name="navigationPopupBottomImageMargins">0dp</item>
        <item name="navigationPopupBottomImageTopMargin">0dp</item>
        <item name="navigationPopupTitleWidth">0dp</item>
        <item name="navigationItemsShouldDisplayIcon">false</item>
        <item name="navigationPopupItemPaddingTop">13dp</item>
        <item name="navigationPopupItemPaddingBottom">13dp</item>
        <!-- About Screen -->
        <item name="aboutLogo">@drawable/harucon2025_about_title</item>
        <item name="aboutLogoMargins">0dp</item>
        <!-- Home Screen -->
        <item name="homeLogo">@drawable/harucon2025_home_image</item>
        <item name="homeLogoMargin">0dp</item>
        <item name="homeLogoMarginTop">10dp</item>
        <item name="homeBottomImage">@null</item>
        <item name="homeBackground">@drawable/harucon2025_home_background</item>
        <item name="homeBackgroundDuringConvention">@drawable/harucon2025_home_background</item>
        <item name="homeToolbarTitle">@null</item>
        <item name="homeToolbarBackground">@color/harucon2025_purple5</item>
        <item name="homeTitleBackground">@drawable/harucon2025_home_title_background</item>
        <item name="homeShowCurrentUpcomingTitles">true</item>
        <item name="homeTitleText">@drawable/harucon2025_home_title_text</item>
        <item name="homeContentBackground">@drawable/harucon2025_home_content_background</item>
        <item name="homeContentText">@drawable/harucon2025_home_content_text</item>
        <item name="homeButtonBackground">@drawable/harucon2025_home_button</item>
        <item name="homeButtonText">@color/white</item>
        <item name="homeButton2Background">@drawable/harucon2025_home_updates_button</item>
        <item name="homeButton2Text">@color/harucon2025_purple4</item>
        <item name="homeEventsListEventBackground">@drawable/harucon2025_rounded_edges_yellow1</item>
        <item name="homeEventsListDivider">@android:color/transparent</item>
        <item name="homeEventsListDividerHeight">10dp</item>
        <item name="homeBoxTopMargin">10dp</item>
        <item name="homeSingleButtonTopMargin">10dp</item>
        <item name="homeFrameTopMargin">10dp</item>
        <!-- Event View -->
        <item name="eventViewLayout">@layout/rounded_convention_event</item>
        <item name="eventViewHeight">104dp</item>
        <item name="eventBackgroundColor">@color/harucon2025_yellow1</item>
        <item name="eventTextColor">@drawable/harucon2025_event_view_text_color</item>
        <item name="eventNameKeywordHighlightColor">@color/harucon2025_green4</item>
        <item name="eventKeywordHighlightColor">@color/harucon2025_green4</item>
        <item name="eventTimeTextColor">@drawable/harucon2025_event_view_time_text_color</item>
        <item name="eventTimeBackground">@drawable/harucon2025_event_view_time_background_color</item>
        <item name="eventFavoriteIcon">@drawable/harucon_gen_favorite_icon</item>
        <item name="eventFavoriteIconColor">@drawable/harucon2025_favorite_icon_color</item>
        <item name="eventFeedbackIcon">@drawable/harucon_gen_event_feedback_icon</item>
        <item name="eventFeedbackIconColor">@drawable/harucon2025_event_feedback_icon_color</item>
        <item name="useEventTextColorFromEventType">false</item>
        <item name="useEventTimeColorFromEventType">false</item>
        <item name="conflictingEventBackground">@drawable/harucon2025_conflicting_event_label_bg</item>
        <item name="conflictingEventLabelTextColor">@color/white</item>
        <item name="ongoingEventBackground">@drawable/harucon2025_ongoing_event_label_bg</item>
        <item name="ongoingEventLabelTextColor">@color/harucon2025_purple4</item>
        <!-- Programme Screen and Programme Search Screen -->
        <item name="eventTimeHeaderBackground">@color/harucon2025_yellow3</item>
        <item name="eventTimeHeaderWidth">match_parent</item>
        <item name="eventTimeHeaderTextColor">@color/harucon2025_purple4</item>
        <item name="eventTimeHeaderMarginTop">10dp</item>
