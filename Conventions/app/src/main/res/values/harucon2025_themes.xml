        <item name="eventTimeHeaderMarginHorizontal">8dp</item>
        <item name="eventTimeHeaderPaddingVertical">4dp</item>
        <item name="marginBetweenEventsListAndNextHeader">0dp</item>
        <item name="fabOnProgrammeTop">true</item>
        <item name="fabOnProgrammeTopAlignment">START</item>
        <item name="searchTitleTextColor">@color/harucon2025_purple5</item>
        <item name="searchTitleBackgroundColor">@color/harucon2025_yellow1</item>
        <item name="programmeSearchBarBackground">@drawable/harucon2025_search_bar_background</item>
        <item name="programmeSearchFilterColor">@color/harucon2025_pink6</item>
        <item name="programmeSearchFilterBackground">@drawable/harucon2025_filter_background</item>
        <!-- Search drawer -->
        <item name="searchDrawerAccentColor">@color/harucon2025_pink6</item>
        <item name="searchDrawerBackground">@color/harucon2025_yellow1</item>
        <item name="searchDrawerTextColor">@color/harucon2025_purple5</item>
        <item name="searchDrawerSeparatorColor">@color/transparent</item>
        <!-- My Events Screen -->
        <item name="nextEventStartTimeBackground">@color/harucon2025_white_transparent60</item>
        <item name="nextEventStartTimeTextColor">@color/harucon2025_purple4</item>
        <item name="conflictingEventsBackground">@null</item>
        <item name="nextEventStartTimeBottomLineColor">@null</item>
        <item name="conflictingEventsSideMargin">0dp</item>
        <item name="conflictingEventsTopBottomMargin">0dp</item>
        <item name="conflictingEventsGroupSeparator">@drawable/harucon2025_conflicting_events_group_separator</item>
        <item name="conflictingEventsGroupSeparatorHeight">4dp</item>
        <item name="conflictingEventsGroupSeparatorMargin">4dp</item>
        <item name="conflictingEventsListBorder">@null</item>
        <item name="freeTimeTextColor">@color/harucon2025_purple4</item>
        <item name="freeTimeBackground">@drawable/harucon2025_transparent_white_inset</item>
        <!-- Feedback Screen -->
        <item name="conventionFeedbackBackgroundColor">@drawable/harucon2025_rounded_edges_yellow1_inset</item>
        <item name="conventionFeedbackTextColor">@drawable/harucon2025_convention_feedback_text_color</item>
        <item name="conventionFeedbackAnswerBackground">@drawable/harucon2025_convention_feedback_answer_bg_selector</item>
        <item name="feedbackMultiAnswerMinWidth">50dp</item>
        <item name="feedbackMultiAnswerPaddingTopBottom">4dp</item>
        <item name="feedbackMultiAnswerPaddingStartEnd">9dp</item>
        <item name="feedbackMultiAnswerPaddingStartFirstAnswer">9dp</item>
        <item name="feedbackMultiAnswerMarginTopBottom">2dp</item>
        <item name="feedbackMultiAnswerMarginBetweenAnswers">9dp</item>
        <item name="feedbackProgressBarColor">@color/harucon2025_pink6</item>
        <item name="feedbackSeparatorColor">@drawable/harucon2025_white_inset</item>
        <!-- Updates Screen -->
        <item name="updateTimeColor">@drawable/harucon2025_update_time_color</item>
        <item name="updateTimeBackground">@null</item>
        <item name="updateItemBorder">@color/harucon2025_pink6</item>
        <item name="updateItemSeparator">@android:color/transparent</item>
        <item name="updateBackground">@drawable/harucon2025_update_background</item>
        <item name="updateTextColor">@color/harucon2025_purple5</item>
        <item name="updateElevation">2dp</item>
        <item name="showNewUpdateIndicator">true</item>
        <item name="newUpdateIndicatorTextColor">@color/harucon2025_yellow1</item>
        <item name="newUpdateIndicatorBackground">@drawable/harucon2025_new_update_indicator_background</item>
        <!-- Event Screen -->
        <item name="eventToolbarColor">@color/harucon2025_purple5</item>
        <item name="eventDetailsDefaultBackground">@drawable/harucon2025_app_background</item>
        <item name="eventTitleBackground">@null</item>
        <item name="eventTitlePadding">0dp</item>
        <item name="eventTitleTextColor">@color/white</item>
        <item name="eventSubTitleTextColor">@color/white</item>
        <item name="eventLecturerTextColor">@color/harucon2025_purple4</item>
        <item name="eventTypeTextColor">@color/harucon2025_purple4</item>
        <item name="eventNameBackground">@drawable/harucon2025_rounded_top_edges_pink6</item>
        <item name="eventSubTitleBackground">@color/harucon2025_pink6</item>
        <item name="eventLecturerBackground">@color/harucon2025_peach1</item>
        <item name="eventTypeBackground">@drawable/harucon2025_rounded_bottom_edges_yellow1</item>
        <item name="eventDetailsBoxColor">@null</item>
        <item name="eventFeedbackBoxColor">@drawable/harucon2025_event_feedback_bg</item>
        <item name="eventFeedbackTextColor">@drawable/harucon2025_event_feedback_text_color</item>
        <item name="eventFeedbackAnswerBackground">@drawable/harucon2025_event_feedback_answer_bg_selector</item>
        <item name="feedbackButtonColor">@drawable/harucon2025_event_feedback_button_color_selector</item>
        <item name="eventFeedbackButtonBackground">@drawable/harucon2025_event_feedback_button</item>
        <item name="eventFeedbackButtonTextColor">@drawable/harucon2025_event_feedback_button_text_color</item>
        <item name="eventFeedbackProgressBarColor">@color/harucon2025_pink6</item>
        <item name="eventVoteBoxColor">@drawable/harucon2025_rounded_edges_peach1</item>
        <item name="eventVoteTextColor">@color/harucon2025_purple4</item>
        <item name="eventVoteButtonBackground">@drawable/harucon2025_event_feedback_button</item>
        <item name="eventVoteButtonTextColor">@drawable/harucon2025_event_feedback_button_text_color</item>
        <item name="eventDescriptionBoxColor">@drawable/harucon2025_rounded_edges_yellow1</item>
        <item name="eventSurveyTextColor">@drawable/harucon2025_event_vote_text_color</item>
        <item name="eventDetailsTextColor">@color/harucon2025_purple4</item>
        <item name="eventDescriptionTextColor">@color/harucon2025_purple4</item>
        <!-- Map Screen -->
        <item name="mapBackground">@drawable/harucon2025_app_background</item>
        <item name="mapShelterButtonBackground">@drawable/harucon2025_map_shelters_button</item>
        <item name="mapDetailButtonsBackground">@drawable/harucon2025_map_shelters_button</item>
        <item name="locationDetailsBackground">@color/white_90</item>
        <item name="locationDetailsTopLineColor">@color/transparent</item>
        <item name="locationDetailsTitleColor">@color/harucon2025_purple4</item>
        <item name="locationDetailsElevation">10dp</item>
        <item name="iconClearMap">@drawable/ic_clear_black</item>
        <item name="iconFloorUp">@drawable/harucon2025_arrow_up</item>
