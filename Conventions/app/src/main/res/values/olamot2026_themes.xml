        <item name="updateItemBorder">@color/olamot2026_blue700</item>
        <item name="updatesSeparatorColor">@color/transparent</item>
        <!-- Event Screen -->
        <item name="eventToolbarColor">?toolbarBackground</item>
        <item name="eventActivityFavoriteColor">?toolbarIconAccentColor</item>
        <item name="eventTitleBackground">@null</item>
        <item name="eventTitlePadding">0dp</item>
        <item name="eventNameBackground">@drawable/olamot2026_blue700_top_round</item>
        <item name="eventTitleTextColor">@color/white</item>
        <item name="eventLecturerBackground">@color/olamot2026_blue25</item>
        <item name="eventLecturerTextColor">@color/olamot2026_blue900</item>
        <item name="eventTypeBackground">@drawable/olamot2026_blue100_bottom_round</item>
        <item name="eventTypeTextColor">@color/olamot2026_blue900</item>
        <item name="eventDetailsBoxColor">@color/transparent</item>
        <item name="eventDetailsTextColor">@color/olamot2026_purple1000</item>
        <item name="eventDetailsHighlightedTextColor">@color/olamot2026_red</item>
        <item name="eventDescriptionBoxColor">@drawable/olamot2026_gray50_round</item>
        <item name="eventDescriptionTextColor">@color/olamot2026_purple1000</item>
        <item name="eventFeedbackBoxColor">@drawable/olamot2026_blue100_round</item>
        <item name="eventFeedbackTextColor">@drawable/olamot2026_event_feedback_text_color</item>
        <item name="eventFeedbackProgressBarColor">@color/olamot2026_blue900</item>
        <item name="eventFeedbackButtonBackground">@drawable/olamot2026_event_feedback_button</item>
        <item name="eventFeedbackButtonTextColor">@drawable/olamot2026_highlighted_button_text_color</item>
        <item name="feedbackButtonColor">@color/olamot2026_blue900</item>
        <item name="eventVoteBoxColor">@drawable/olamot2026_purple100_round</item>
        <item name="eventVoteTextColor">@color/olamot2026_purple1000</item>
       <item name="eventVoteButtonBackground">@drawable/olamot2026_event_vote_button</item>
        <!-- Map Screen -->
        <item name="mapBackground">?activitiesBackground</item>
        <item name="locationDetailsBackground">@color/white_90</item>
        <item name="locationDetailsTopLineColor">@color/transparent</item>
        <item name="iconClearMap">@drawable/ic_clear_black</item>
        <item name="locationDetailsTitleColor">@color/olamot2026_gray900</item>
        <item name="locationDetailsElevation">3dp</item>
        <item name="floorChangeBackground">@color/olamot2026_gray200</item>
        <item name="mapSearchFiltersBackground">@color/olamot2026_purple25</item>
        <item name="mapSearchResultsBackground">@color/olamot2026_green50_transparent_95</item>
        <item name="mapSearchBorder">@color/transparent</item>
        <item name="mapSearchPaneElevation">10dp</item>
