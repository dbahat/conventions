        <item name="homeEventTimeText">@color/olamot2026_gray800</item>
        <item name="homeEventHallText">@color/olamot2026_gray800</item>
        <item name="homeButtonBackground">@drawable/olamot2026_home_button</item>
        <item name="homeButton2Background">@drawable/olamot2026_home_button2</item>
        <item name="homeButtonText">@color/white</item>
        <item name="homeButton2Text">@color/white</item>
        <item name="homeBottomImage">@null</item>
        <item name="homeEventsListDivider">@color/transparent</item>
        <item name="homeEventsListDividerHeight">10dp</item>
        <item name="homeEventsListEventBackground">@drawable/olamot2026_gray50_round</item>
        <!-- Event View -->
        <item name="eventViewLayout">@layout/rounded_convention_event</item>
        <item name="eventViewHeight">104dp</item>
        <item name="eventViewCornerRadius">4dp</item>
        <item name="eventBackgroundColor">@color/olamot2026_gray50</item>
        <item name="eventTextColor">@drawable/olamot2026_event_view_text_color</item>
        <item name="eventTimeTextColor">@drawable/olamot2026_event_time_text_color</item>
        <item name="eventTimeBackground">@drawable/olamot2026_event_time_background</item>
        <item name="eventDetailsColor">?eventTextColor</item>
        <item name="eventFavoriteIcon">@drawable/favorite_full</item>
        <item name="eventFavoriteIconColor">@drawable/olamot2026_event_favorite_icon_color</item>
        <item name="eventFeedbackIcon">@drawable/feedback_icon</item>
        <item name="eventFeedbackIconColor">@drawable/olamot2026_feedback_icon_color</item>
        <item name="eventStartMargin">0dp</item>
        <item name="conflictingEventBackground">@drawable/olamot2026_conflicting_event_label_bg</item>
        <item name="conflictingEventLabelTextColor">@color/white</item>
        <item name="ongoingEventBackground">@drawable/olamot2026_ongoing_event_label_bg</item>
