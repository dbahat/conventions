<?xml version="1.0" encoding="utf-8"?>
<resources>
   <style name="AppBaseTheme.Olamot2026" parent="AppBaseTheme.Light.DarkToolbar">
        <!-- Sub-themes -->
        <item name="android:dialogTheme">@style/AppDialogTheme.Olamot2026</item>
        <item name="alertDialogTheme">@style/AppAlertDialogTheme.Olamot2026</item>
        <!-- General -->
        <item name="lightStatusBarIcons">true</item>
        <item name="android:colorPrimaryDark">@color/black</item> <!-- Status bar color without edge-to-edge (in edge-to-edge, it's the toolbar color) -->
        <!-- Used in: default selected checkbox/switch color, settings titles,
             cursor color in all edit texts. Also used as the default action button color and map search checkbox color. -->
        <item name="colorAccent">@color/olamot2026_blue700</item>
        <!-- This color should be readable over the activities background.
             Used as the text color in: accessibility, arrival methods.
             Also used as default for many texts and as the default "large text" color (e.g. in settings). -->
        <item name="android:textColorPrimary">@color/olamot2026_purple1000</item>
        <!-- Used in: default unselected checkbox color and default "medium/small" texts (e.g. in settings). -->
        <item name="android:textColorSecondary">@color/olamot2026_purple1000</item>
        <item name="android:colorBackground">@null</item>
        <item name="android:textColorHint">@color/olamot2026_blue700</item>
        <item name="android:textColorLink">@color/olamot2026_blue700</item>
        <item name="actionButtonColor">@color/olamot2026_purple700</item>
        <item name="actionButtonIcon">@drawable/search</item>
        <item name="hintTextColor">@color/olamot2026_blue700</item>
        <item name="swipeToRefreshColor">@color/white</item>
        <item name="swipeToRefreshBackgroundColor">@color/olamot2026_purple700</item>
        <item name="snackbarActionColor">@color/olamot2026_blue400</item>
        <item name="highlightedButtonBackground">@drawable/highlighted_button</item>
        <item name="borderlessButtonColor">@color/olamot2026_blue1000</item>
        <item name="activitiesBackground">@drawable/olamot2026_background</item>
        <item name="infoActivitiesTextBackground">@drawable/olamot2026_rounded_edges_gray50_inset</item>
        <item name="contentStartMargin">0dp</item>
        <item name="contentEndMargin">0dp</item>
        <item name="eventListDivider">@drawable/transparent_event_list_divider</item>
        <item name="separatorColor">@null</item>
        <!-- These are used for buttons. They should be usable when the background is:
             Event screen vote
             Feedback screen
             Map bottom info panel
             Arrival methods screen
         -->
        <item name="buttonColor">@color/olamot2026_blue700</item>
        <item name="buttonColorPressed">@color/olamot2026_blue400</item>
        <item name="buttonColorDisabled">@color/olamot2026_gray200</item>
        <item name="buttonTextColor">@drawable/olamot2026_highlighted_button_text_color</item>

        <!-- Tabs -->
        <item name="tabsBackground">@color/olamot2026_purple25</item>
        <item name="unselectedTabTextColor">@color/olamot2026_purple1000</item>
        <item name="selectedTabTextColor">@color/olamot2026_purple1000</item>
        <item name="selectedTabIndicator">@drawable/tab_indicator</item>
        <item name="selectedTabIndicatorColor">@color/olamot2026_purple1000</item>

        <!-- Notifications -->
        <item name="notificationSmallIcon">@drawable/olamot2026_notification_icon</item>
        <!-- Toolbar -->
        <item name="toolbarBackground">@color/olamot2026_purple1000</item>
        <item name="toolbarIconAccentColor">@color/olamot2026_copper</item>
        <!-- Navigation Popup -->
        <item name="navigationPopupBackground">@color/olamot2026_green25</item>
        <item name="navigationPopupTitle">@null</item>
        <item name="navigationPopupTitleMargins">10dp</item>
        <item name="navigationPopupBottomImage">@null</item>
        <item name="navigationPopupNotSelectedColor">@color/olamot2026_purple900</item>
        <item name="navigationPopupSelectedColor">@color/olamot2026_purple900</item>
        <item name="navigationPopupSelectedBackground">@color/olamot2026_green200</item>
        <item name="navigationPopupTopSelectedBackground">@color/olamot2026_green200</item>
        <item name="navigationPopupSeparatorColor">@color/olamot2026_green200</item>
        <item name="navigationItemsShouldDisplayIcon">false</item>
        <!-- About Screen -->
        <item name="aboutLogo">@drawable/olamot2026_logo_title</item>
        <item name="aboutLogoMargins">50dp</item>
        <!-- Home Screen -->
        <item name="homeBoxTopMargin">10dp</item>
        <item name="homeSingleButtonTopMargin">10dp</item>
        <item name="homeButtonsSideMargin">0dp</item>
        <item name="homeBackground">@drawable/olamot2026_background</item>
        <item name="homeLogo">@drawable/olamot2026_home_logo_selector</item>
        <item name="homeLogoMargin">0dp</item>
        <item name="homeFrameTopMargin">5dp</item>
        <item name="homeFrameBottomMargin">50dp</item>
        <item name="homeToolbarBackground">@null</item>
        <item name="homeToolbarTitle">@null</item>
        <item name="homeTitleBackground">@drawable/olamot2026_home_title_background</item>
        <item name="homeTitleText">@drawable/olamot2026_home_title_text_color</item>
        <item name="homeEventsMargin">20dp</item>
        <item name="homeShowCurrentUpcomingTitles">true</item>
        <item name="homeContentBackground">@drawable/olamot2026_home_content_background</item>
