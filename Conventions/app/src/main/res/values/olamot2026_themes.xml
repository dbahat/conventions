    <style name="AppBaseTheme.Olamot2026.Event">
<!--        <item name="android:textColorLink">@color/...</item>-->
    </style>

    <style name="AppBaseTheme.Olamot2026.Settings">
        <item name="android:textColorPrimary">@color/olamot2026_purple1000</item>
         <item name="android:textColorSecondary">@color/olamot2026_purple1000</item>
    </style>

     <style name="AppBaseTheme.Olamot2026.Home">
          <item name="toolbarLogo">@drawable/ic_menu_black_24dp</item>
          <item name="lightStatusBarIcons">false</item>
     </style>


    <style name="AppDialogTheme.Olamot2026" parent="Theme.AppCompat.Light.Dialog">
        <!-- This is the default starting API23. In any case the title is always left-justified so it's best to not use it. -->
        <item name="android:windowNoTitle">true</item>
        <item name="colorAccent">@color/olamot2026_blue700</item>
        <item name="android:textColorPrimary">@color/olamot2026_purple1000</item>
        <item name="borderlessButtonColor">@color/olamot2026_blue700</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="AppAlertDialogTheme.Olamot2026" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/olamot2026_blue700</item>
        <item name="android:textColorPrimary">@color/olamot2026_purple1000</item>
        <item name="borderlessButtonColor">@color/olamot2026_blue700</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="AppBaseTheme.Olamot2026.Splash">
        <item name="android:windowBackground">@drawable/olamot2026_background</item>
    </style>

     <style name="TransparentTheme.Olamot2026" parent="TransparentTheme">
          <!-- Custom Tabs -->
          <item name="customTabsToolbarColor">@color/olamot2026_purple1000</item>
     </style>
