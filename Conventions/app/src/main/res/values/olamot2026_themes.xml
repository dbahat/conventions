        <item name="marginBetweenEventsListAndNextHeader">0dp</item>
        <!-- Programme Search Screen -->
        <item name="searchTitleBackgroundColor">@color/olamot2026_purple25</item>
        <item name="searchTitleHorizontalPadding">8dp</item>
        <item name="searchTitleTextColor">@color/olamot2026_purple1000</item>
        <item name="programmeSearchBarBackground">@drawable/olamot2026_search_bar_background_purple</item>
        <item name="programmeSearchFilterColor">@color/olamot2026_green1000</item>
        <item name="programmeSearchFilterBackground">@drawable/olamot2026_filter_background</item>
        <item name="eventNameKeywordHighlightColor">@color/olamot2026_blue500</item>
        <item name="eventKeywordHighlightColor">@color/olamot2026_blue500</item>
        <item name="searchDrawerAccentColor">@color/olamot2026_blue700</item>
        <item name="searchDrawerBackground">@color/olamot2026_green25</item>
        <item name="searchDrawerTextColor">@color/olamot2026_gray900</item>
        <item name="searchDrawerSeparatorColor">@color/transparent</item>
        <!-- My Events Screen -->
        <item name="nextEventStartTimeBackground">@color/transparent</item>
        <item name="nextEventStartTimeTextColor">@color/olamot2026_blue700</item>
        <item name="nextEventStartTimeBottomLineColor">@color/transparent</item>
        <item name="conflictingEventsListBorder">@null</item>
        <item name="conflictingEventsBackground">@null</item>
        <item name="conflictingEventsGroupSeparator">@drawable/olamot2026_conflicting_events_group_separator</item>
        <item name="conflictingEventsGroupSeparatorHeight">4dp</item>
        <item name="conflictingEventsGroupSeparatorMargin">4dp</item>
        <item name="freeTimeTextColor">@color/olamot2026_blue700</item>
        <item name="importEventsButtonIcon">@drawable/system_update_40px</item>
        <item name="myEventsFABMaxImageSize">36dp</item>
        <!-- User Details Dialog -->
        <item name="userDetailsTextColor">@color/olamot2026_gray800</item>
        <item name="logoutButtonTextColor">@color/olamot2026_red</item>
        <!-- Feedback Screen -->
        <item name="conventionFeedbackBackgroundColor">@drawable/olamot2026_rounded_edges_gray50_inset</item>
        <item name="feedbackProgressBarColor">@color/olamot2026_blue700</item>
        <item name="conventionFeedbackTextColor">@drawable/olamot2026_feedback_text_color</item>
        <item name="feedbackEventDateHeaderTextColor">@color/olamot2026_purple1000</item>
        <!-- Updates Screen -->
        <item name="updateTimeBackground">@null</item>
        <item name="updateTimeColor">@drawable/olamot2026_update_time_text_color</item>
        <item name="showNewUpdateIndicator">true</item>
        <item name="newUpdateIndicatorTextColor">@color/white</item>
        <item name="newUpdateIndicatorBackground">@drawable/olamot2026_new_update_indicator_background</item>
