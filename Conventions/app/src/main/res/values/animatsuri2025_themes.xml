    <style name="AppDialogTheme.Animatsuri2025" parent="Theme.AppCompat.Light.Dialog">
        <!-- This is the default starting API23. In any case the title is always left-justified so it's best to not use it. -->
        <item name="android:windowNoTitle">true</item>
        <!-- Used for configure notifications popup title and separator -->
        <item name="colorAccent">@color/animatsuri2025_magenta50</item>
        <item name="borderlessButtonColor">@color/animatsuri2025_magenta50</item>
        <item name="android:textColorPrimary">@color/animatsuri2025_magenta1200</item>
        <item name="android:layoutDirection">rtl</item>
        <!-- For stands popup in map - unselected stand text color -->
        <item name="mapSearchText">@color/animatsuri2025_magenta1200</item>
    </style>

    <style name="AppAlertDialogTheme.Animatsuri2025" parent="Theme.AppCompat.Light.Dialog.Alert">
        <!-- Used for configure notifications popup title and separator -->
        <item name="colorAccent">@color/animatsuri2025_magenta50</item>
        <item name="borderlessButtonColor">@color/animatsuri2025_magenta50</item>
        <item name="android:textColorPrimary">@color/animatsuri2025_magenta1200</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

