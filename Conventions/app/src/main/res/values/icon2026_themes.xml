    <style name="AppDialogTheme.Icon2026" parent="Theme.AppCompat.Light.Dialog">
        <!-- This is the default starting API23. In any case the title is always left-justified so it's best to not use it. -->
        <item name="android:windowNoTitle">true</item>
        <item name="colorAccent">@color/icon2026_blue700</item>
        <item name="android:textColorPrimary">@color/icon2026_brown600</item>
        <item name="borderlessButtonColor">@color/icon2026_blue700</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="AppAlertDialogTheme.Icon2026" parent="Theme.AppCompat.Light.Dialog.Alert">
