        <item name="android:textColorPrimary">@color/icon2026_brown600</item>
        <!-- Used in: default unselected checkbox color and default "medium/small" texts (e.g. in settings). -->
        <item name="android:textColorSecondary">@color/icon2026_brown600</item>
