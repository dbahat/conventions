<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Background layer (Semi-transparent) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white_90" />
        </shape>
    </item>

    <!-- 2. The Border layer (3 sides: Left, Right, Bottom) -->
    <!-- We use a negative top inset to "push" the top stroke out of the view bounds -->
    <item android:top="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/harucon2026_pink1" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>