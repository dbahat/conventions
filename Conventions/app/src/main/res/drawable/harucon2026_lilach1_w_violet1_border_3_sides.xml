<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The "Border" layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="2dp" android:topRightRadius="2dp"/>
            <solid android:color="@color/harucon2026_violet1" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape>
            <corners android:topLeftRadius="2dp" android:topRightRadius="2dp" />
            <solid android:color="@color/harucon2026_lilach1" />
        </shape>
    </item>
</layer-list>