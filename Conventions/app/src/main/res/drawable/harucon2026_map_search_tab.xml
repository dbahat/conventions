<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The "Border" layer (Solid red) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/harucon2026_red1" />
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp" />
        </shape>
    </item>

    <!-- 2. The "Background" layer (Solid peach) -->
    <!-- We inset it from Top, Left, and Right by 2dp to reveal the red layer underneath.
         We leave bottom at 0dp so it covers the red layer completely at the bottom. -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/harucon2026_peach3" />
            <corners
                android:topLeftRadius="6dp"
                android:topRightRadius="6dp" />
        </shape>
    </item>
</layer-list>